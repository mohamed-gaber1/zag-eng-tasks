class BankAccount {
    owner: string;
    balance: number;

    constructor(owner: string, balance: number) {
        this.owner = owner;
        this.balance = balance;
    }

    deposit(x:number): void {
        this.balance+=x;
    }
    withdraw(x:number): void {
        if(x>this.balance){
            console.log("There aren't enough money");
            return;
        }
        this.balance-=x;
    }
    getBalance():void{
        console.log(this.balance);
    }
}

const person1 = new BankAccount("Gaber", 1.75);
person1.getBalance();
